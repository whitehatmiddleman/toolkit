\n    align-items: center;\n    justify-content: space-between;\n    flex-shrink: 0;\n  }\n\n  .match-count {\n    color: var(--accent2);\n    font-size: 11px;\n  }\n\n  .text-editor-wrap {\n    flex: 1;\n    position: relative;\n    overflow: hidden;\n  }\n\n  /* mirror div sits behind, contenteditable sits on top */\n  #text-input {\n    position: absolute;\n    inset: 0;\n    background: transparent;\n    color: var(--text);\n    font-family: 'Fira Code', 'Cascadia Code', monospace;\n    font-size: 13px;\n    line-height: 1.6;\n    padding: 12px;\n    border: none;\n    outline: none;\n    overflow: auto;\n    white-space: pre-wrap;\n    word-break: break-all;\n    caret-color: var(--accent);\n  }\n\n  #text-input mark {\n    background: var(--mark-bg);\n    border-bottom: 2px solid var(--mark-border);\n    border-radius: 2px;\n    color: inherit;\n  }\n\n  /* RIGHT PANEL */\n  .right-panel {\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n\n  /* REGEX INPUT */\n  .regex-section {\n    background: var(--surface);\n    border-bottom: 1px solid var(--border);\n    padding: 12px;\n    flex-shrink: 0;\n  }\n\n  .regex-section .panel-header {\n    background: transparent;\n    border: none;\n    padding: 0 0 8px 0;\n  }\n\n  .regex-row {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    background: var(--surface2);\n    border: 1px solid var(--border);\n    border-radius: var(--radius);\n    padding: 4px 8px;\n  }\n\n  .regex-slash { color: var(--text-dim); font-family: monospace; font-size: 16px; }\n\n  #pattern-input {\n    flex: 1;\n    background: transparent;\n    border: none;\n    outline: none;\n    color: var(--accent);\n    font-family: 'Fira Code', 'Cascadia Code', monospace;\n    font-size: 14px;\n    caret-color: var(--text);\n  }\n\n  #flags-input {\n    width: 60px;\n    background: transparent;\n    border: none;\n    border-left: 1px solid var(--border);\n    outline: none;\n    color: var(--accent2);\n   
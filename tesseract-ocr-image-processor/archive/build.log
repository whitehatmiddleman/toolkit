{"type":"assistant","message":{"model":"claude-sonnet-4-6","id":"msg_01DYyjahQwhJKWHeT6RtQH7h","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011DDbfCLmifeeGon8okeUWQ","name":"Write","input":{"file_path":"/home/sysoper/workspace/WhileISleep/batch-output/tesseract-ocr-image-processor/ocr.sh","content":"#!/usr/bin/env bash\nset -euo pipefail\n\nreadonly DEFAULT_LANG=\"eng\"\n\nusage() {\n    echo \"Usage: $(basename \"$0\") <input_dir> <output_dir> [--lang <lang>]\" >&2\n    exit 1\n}\n\nif [[ $# -lt 2 ]]; then\n    usage\nfi\n\nINPUT_DIR=\"$1\"\nOUTPUT_DIR=\"$2\"\nLANG=\"$DEFAULT_LANG\"\nshift 2\n\nwhile [[ $# -gt 0 ]]; do\n    case \"$1\" in\n        --lang)\n            if [[ $# -lt 2 ]]; then\n                echo \"Error: --lang requires an argument\" >&2\n                usage\n            fi\n            LANG=\"$2\"\n            shift 2\n            ;;\n        *)\n            echo \"Unknown option: $1\" >&2\n            usage\n            ;;\n    esac\ndone\n\nreadonly INPUT_DIR OUTPUT_DIR LANG\n\nif [[ ! -d \"$INPUT_DIR\" ]]; then\n    echo \"Error: input directory does not exist: $INPUT_DIR\" >&2\n    exit 1\nfi\n\nmkdir -p \"$OUTPUT_DIR\"\nreadonly LOG_FILE=\"$OUTPUT_DIR/ocr.log\"\n\nlog() {\n    echo \"$1\" | tee -a \"$LOG_FILE\"\n}\n\nlog \"OCR run started: $(date -Iseconds)\"\nlog \"Input:  $INPUT_DIR\"\nlog \"Output: $OUTPUT_DIR\"\nlog \"Lang:   $LANG\"\n\nSUCCESS=0\nFAILURE=0\nSKIPPED=0\n\nwhile IFS= read -r -d '' img; do\n    rel=\"${img#\"$INPUT_DIR\"/}\"\n    filename=\"$(basename \"$img\")\"\n    ext=\"${filename##*.}\"\n    ext_lower=\"${ext,,}\"\n\n    if [[ ! \"$ext_lower\" =~ ^(png|jpg|jpeg|tiff|tif)$ ]]; then\n        log \"SKIP (unsupported extension): $rel\"\n        SKIPPED=$((SKIPPED + 1))\n        continue\n    fi\n\n    base=\"${rel%.*}\"\n    out_base=\"$OUTPUT_DIR/$base\"\n    out_dir=\"$(dirname \"$out_base\")\"\n    mkdir -p \"$out_dir\"\n\n    log \"Processing: $rel\"\n    exit_code=0\n    tesseract \"$img\" \"$out_base\" -l \"$LANG\" txt hocr pdf 2>>\"$LOG_FILE\" || exit_code=$?\n    if [[ $exit_code -eq 0 ]]; then\n        log \"OK: $base (.txt .hocr .pdf)\"\n        SUCCESS=$((SUCCESS + 1))\n    else\n        log \"FAIL: $rel (exit code $exit_code)\"\n        FAILURE=$((FAILURE + 1))\n    fi\n\ndone < <(find \"$INPUT_DIR\" -type f \\( -iname \"*.png\" -o -iname \"*.jpg\" -o -iname \"*.jpeg\" -o -iname \"*.tiff\" -o -iname \"*.tif\" \\) -print0)\n\nlog \"\"\nlog \"Done: $SUCCESS succeeded, $FAILURE failed, $SKIPPED skipped\"\n\nif [[ $FAILURE -gt 0 ]]; then\n    exit 1\nfi\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":975,"cache_read_input_tokens":18202,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":975},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"4a9a0c21-250b-47df-bfb8-035bd6b27178","uuid":"e09bf92b-1b0f-4433-8d99-2939e6ea19cf"}
